{
  "name": "@teoclub/cordis",
  "description": "Meta-Framework for Modern JavaScript Applications",
  "version": "6.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teoclub/cordis.git",
    "directory": "packages/cordis"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Shigma <shigma10826@gmail.com>",
  "teoclub": {
    "source": {
      "repository": "deepseek-ai/deepseek-harness",
      "path": "vendor/cordis",
      "upstreamPackage": "@deepseek-ai/cordis",
      "upstreamVersion": "4.0.5-alpha.2",
      "commit": "2fbf4359b82fb94c03dcce0b831660d87f12ea5c"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "bin.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "cordis": "bin.js"
  },
  "sideEffects": false,
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@teoclub/kit": "~1.8.6"
  },
  "peerDependencies": {
    "@teoclub/cordis-plugin-include": "~1.0.10",
    "@teoclub/cordis-plugin-loader": "~1.0.6"
  },
  "peerDependenciesMeta": {
    "@teoclub/cordis-plugin-include": {
      "optional": true
    },
    "@teoclub/cordis-plugin-loader": {
      "optional": true
    }
  }
}
