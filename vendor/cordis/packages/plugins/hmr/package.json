{
  "name": "@teoclub/cordis-plugin-hmr",
  "description": "Hot Module Replacement Plugin for Cordis",
  "version": "1.0.16",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teoclub/cordis.git",
    "directory": "packages/plugins/hmr"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Shigma <shigma10826@gmail.com>",
  "teoclub": {
    "source": {
      "repository": "deepseek-ai/deepseek-harness",
      "path": "vendor/hmr",
      "upstreamPackage": "@deepseek-ai/cordis-plugin-hmr",
      "upstreamVersion": "1.0.16",
      "commit": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "^4.0.3",
    "@teoclub/kit": "^1.8.2",
    "picomatch": "^4.0.3",
    "@teoclub/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@teoclub/cordis-plugin-timer": "^1.1.3",
    "@teoclub/cordis": "^5.0.0"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/picomatch": "^3.0.2",
    "esbuild": "^0.28.1"
  },
  "@teoclub/cordis": {
    "services": {
      "required": [
        "timer"
      ]
    },
    "description": {
      "en": "Hot Module Replacement",
      "zh": "模块热替换"
    }
  }
}
