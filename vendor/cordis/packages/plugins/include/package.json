{
  "name": "@teoclub/cordis-plugin-include",
  "description": "Include files in cordis configurations",
  "version": "1.0.6",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teoclub/cordis.git",
    "directory": "packages/plugins/include"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Shigma <shigma10826@gmail.com>",
  "teoclub": {
    "source": {
      "repository": "deepseek-ai/deepseek-harness",
      "path": "vendor/include",
      "upstreamPackage": "@deepseek-ai/cordis-plugin-include",
      "upstreamVersion": "1.0.6",
      "commit": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@teoclub/kit": "^1.8.2",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@teoclub/cordis-plugin-loader": "^1.0.2",
    "@teoclub/cordis": "^5.0.0"
  }
}
