{
  "name": "@teoclub/code-minimal",
  "description": "Rigo Minimal Code Bundle (Issue 032): repository context + approved workspace file read/write over the unchanged core",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/teoclub/rigo.git", "directory": "packages/bundle/code-minimal" },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "license": "MIT",
  "teoclub": { "origin": "local", "issue": "032" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "exports": {
    ".": { "development": "./src/index.ts", "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@teoclub/code-context-repository": "*",
    "@teoclub/code-file-actions": "*",
    "@teoclub/cordis": "*",
    "@teoclub/harness-app-boot": "*",
    "@teoclub/harness-context": "*",
    "@teoclub/harness-session": "*",
    "@teoclub/shared-actions": "*",
    "@teoclub/shared-approvals": "*",
    "@teoclub/shared-audit": "*",
    "@teoclub/shared-session-persistence-sqlite": "*",
    "@teoclub/shared-storage-sqlite-node": "*"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "cordis.patch.yml"]
}
