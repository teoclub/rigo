{
  "name": "@teoclub/harness-llm",
  "description": "Provider-neutral LLM service interface for Rigo",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teoclub/rigo.git",
    "directory": "packages/harness/llm"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "teoclub": {
    "source": {
      "repository": "deepseek-ai/deepseek-harness",
      "path": "packages/llm/llm",
      "upstreamPackage": "@deepseek-ai/dsh-llm",
      "upstreamVersion": "0.1.6-alpha.1",
      "commit": "0a15e36e7f82b6ed45af6fa9759f29b40dcd965d",
      "classification": "KEEP"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "development": "./src/invariant.ts",
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "development": "./src/types.ts",
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "development": "./src/brand.ts",
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./message": {
      "development": "./src/message.ts",
      "types": "./lib/types/message.d.ts",
      "default": "./lib/types/message.js"
    },
    "./assistant-stream": {
      "development": "./src/assistant-stream.ts",
      "types": "./lib/types/assistant-stream.d.ts",
      "default": "./lib/types/assistant-stream.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@teoclub/harness-protocol": "*",
    "@teoclub/harness-crypto": "*",
    "@teoclub/harness-values": "*",
    "@teoclub/schemastery": "*",
    "@teoclub/harness-timeout": "*",
    "@teoclub/harness-brand": "*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@teoclub/cordis": "*"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ]
}
