{
  "name": "@teoclub/harness-app-boot",
  "description": "Minimal boot: mounts the default agent plugins on one Cordis root.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teoclub/rigo.git",
    "directory": "packages/harness/app-boot"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "teoclub": {
    "source": {
      "repository": "deepseek-ai/deepseek-harness",
      "path": "packages/boot/app-boot",
      "upstreamPackage": "@deepseek-ai/dsh-app-boot",
      "upstreamVersion": "0.1.6-alpha.1",
      "commit": "0a15e36e7f82b6ed45af6fa9759f29b40dcd965d",
      "classification": "ADAPT"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@teoclub/cordis": "*",
    "@teoclub/harness-agent": "*",
    "@teoclub/harness-agent-loop": "*",
    "@teoclub/harness-llm": "*",
    "@teoclub/harness-session": "*",
    "@teoclub/harness-session-projection": "*",
    "@teoclub/harness-system-prompt": "*",
    "@teoclub/harness-tools": "*"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ]
}
