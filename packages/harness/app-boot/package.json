{
  "name": "@teoclub/harness-app-boot",
  "description": "Shared boot glue for the app bins: .env loading, fail-loud Loader guards, snapshot-aware config resolution, and the Loader boot sequence",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teoclub/rigo.git",
    "directory": "packages/harness/app-boot"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "teoclub": {
    "source": {
      "repository": "deepseek-ai/deepseek-harness",
      "path": "packages/boot/app-boot",
      "upstreamPackage": "@deepseek-ai/dsh-app-boot",
      "upstreamVersion": "0.1.6-alpha.1",
      "commit": "0a15e36e7f82b6ed45af6fa9759f29b40dcd965d",
      "classification": "ADAPT"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker/profile-resolution-bootstrap": {
      "development": "./src/profile-resolution/worker-bootstrap.ts",
      "types": "./lib/types/profile-resolution/worker-bootstrap.d.ts",
      "default": "./lib/worker/profile-resolution-bootstrap.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@teoclub/harness-package-manifest": "*",
    "@teoclub/harness-atomic-write": "*",
    "node-addon-require-builtin": "^0.1.6",
    "resolve.exports": "^2.0.3",
    "chokidar": "^4.0.3",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@teoclub/harness-launch-environment": "*",
    "@teoclub/cordis-plugin-include": "*",
    "@teoclub/cordis-plugin-loader": "*",
    "@teoclub/cordis-plugin-group": "*",
    "@teoclub/cordis-plugin-hmr": "*",
    "@teoclub/harness-system-prompt": "*",
    "@teoclub/harness-home-paths": "*",
    "@teoclub/cordis": "*",
    "@teoclub/harness-agent": "*",
    "@teoclub/harness-agent-loop": "*",
    "@teoclub/harness-llm": "*",
    "@teoclub/harness-session": "*",
    "@teoclub/harness-tools": "*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  },
  "files": [
    "lib/index.js",
    "lib/worker/profile-resolution-bootstrap.js",
    "lib/types/**/*.d.ts"
  ]
}
