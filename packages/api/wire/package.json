{
  "name": "@teoclub/api-wire",
  "description": "Rigo /api/v1 wire contract (Issue 039): the single source of the HTTP/SSE payload shapes and the SSE frame decoder, shared by the host (api-http), the client (work-web) and the tests",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/teoclub/rigo.git", "directory": "packages/api/wire" },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "license": "MIT",
  "teoclub": { "origin": "local", "issue": "039" },
  "exports": {
    ".": { "development": "./src/index.ts", "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"]
}
